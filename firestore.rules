rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isProjectOwner() {
      return isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        ('studioId' in resource.data && resource.data.studioId == request.auth.uid)
      );
    }

    function isProjectCreator() {
      return isAuthenticated() && (
        request.resource.data.ownerId == request.auth.uid ||
        ('studioId' in request.resource.data && request.resource.data.studioId == request.auth.uid)
      );
    }

    function isOrderParticipant() {
      return isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        ('studioId' in resource.data && resource.data.studioId == request.auth.uid) ||
        ('customerId' in resource.data && resource.data.customerId == request.auth.uid)
      );
    }

    // Projects: Client 4K video galleries & delivery portals
    match /projects/{projectId} {
      // 1. Unauthenticated users cannot list projects; only authenticated studios can list
      allow list: if isAuthenticated();

      // 2. Read single project (get):
      // - Studio owners can read any of their own projects (draft or published)
      // - Gallery guests can ONLY read explicitly published or delivered client galleries
      allow get: if isProjectOwner()
                 || (resource.data.isPublished == true || resource.data.status == 'delivered' || resource.data.status == 'published');

      // 3. Create: Authenticated studio owner creating a project assigned to their UID
      allow create: if isValidId(projectId) && isProjectCreator();

      // 4. Update: Only the owning studio; ownership cannot be hijacked
      allow update: if isProjectOwner()
                    && (!('ownerId' in request.resource.data) || request.resource.data.ownerId == resource.data.ownerId);

      // 5. Delete: Only the owning studio
      allow delete: if isProjectOwner();
    }

    // Orders: Fine art print and album store orders
    // Financial records are strictly managed via trusted server-side flows (Stripe / backend)
    match /orders/{orderId} {
      // Arbitrary visitors cannot list orders
      allow list: if isAuthenticated();

      // Read single order: Only the owning studio or the purchasing customer
      allow get: if isOrderParticipant();

      // Prevent untrusted clients from creating fabricated financial records or changing prices
      // All order creations and status updates must originate from trusted server-side flows
      allow create, update, delete: if false;
    }

    // Studios: Professional filmmaker studio profile and settings
    match /studios/{studioId} {
      // Unauthenticated users cannot list or read studios
      allow list: if isAuthenticated();

      // Studio owner only
      allow get: if isAuthenticated() && (request.auth.uid == studioId || resource.data.ownerId == request.auth.uid);

      // Create, update, delete: Studio owner only
      allow create: if isAuthenticated() && (request.auth.uid == studioId || ('ownerId' in request.resource.data && request.resource.data.ownerId == request.auth.uid));
      allow update, delete: if isAuthenticated() && (request.auth.uid == studioId || ('ownerId' in resource.data && resource.data.ownerId == request.auth.uid));
    }

    // Health / Connection test doc
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
